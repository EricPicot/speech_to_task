# OpenRouter API Configuration
# Obtenir votre clé sur https://openrouter.ai/
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Notion API Configuration
# Obtenir votre clé API et l'ID de votre base de données sur https://www.notion.so/my-integrations
NOTION_API_KEY=your_notion_api_key_here
NOTION_DATABASE_ID=your_notion_database_id_here

# Application Settings
AUDIO_INPUT_DIR=./audio_input
TRANSCRIPT_OUTPUT_DIR=./transcripts
LOG_DIR=./logs

# Frontend Configuration
BACKEND_URL=http://localhost:8080  # En mode local
# BACKEND_URL=http://backend:8080  # En mode Docker

# Debugging (1 pour activer, 0 pour désactiver)
DEBUG=0 